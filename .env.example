# Copy to apps/web/.env.local (web) and/or set in your shell (ingest).

# Where models drop their JSON. Defaults to the OneDrive path if unset.
FEED_DIR=C:\Users\ljdie\OneDrive\Documents\dashboard_feed

# Web app data source: mock (demo) | feed (read folder) | supabase (read DB)
DATA_SOURCE=feed

# Optional fresh-start cutoff: ignore any slate dated before this (YYYY-MM-DD).
# TRACKING_START=2026-08-05

# Postgres/Supabase connection — required for DATA_SOURCE=supabase and for `pnpm ingest`.
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
